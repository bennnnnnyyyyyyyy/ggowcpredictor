{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "ggowcpredictor",
    "compatibility_date": "2026-06-11",
    "main": "workers/live-results.js",
    "triggers": {
        "crons": [
            "*/5 * * * *"
        ]
    },
    // Environment variables accessible inside your worker via env.KV_KEY, etc.
    "vars": {
        "ENVIRONMENT": "production"
    },
    "observability": {
        "enabled": false,
        "head_sampling_rate": 1,
        "logs": {
            "enabled": true,
            "head_sampling_rate": 1,
            "persist": true,
            "invocation_logs": true
        },
        "traces": {
            "enabled": false,
            "persist": true,
            "head_sampling_rate": 1
        }
    },
    "rules": [
        {
            "type": "Text",
            "globs": ["**/*.html"],
            "fallthrough": false
        }
    ], // <-- Added the missing comma here!
    // Uncomment if you need a KV Namespace for storing data (like match predictions)
    "kv_namespaces": [
        {
            "binding": "PREDICTIONS_KV",
            "id": "your_kv_namespace_id_here"
        }
    ]
}